{
  "name": "fhirforge",
  "version": "0.11.0",
  "description": "Embeddable FHIR storage library for Node and TypeScript. In development.",
  "license": "Apache-2.0",
  "author": "Scott Schlegel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlegz/fhirforge.git",
    "directory": "packages/fhirforge"
  },
  "homepage": "https://github.com/schlegz/fhirforge#readme",
  "bugs": {
    "url": "https://github.com/schlegz/fhirforge/issues"
  },
  "keywords": [
    "fhir",
    "hl7",
    "healthcare",
    "typescript",
    "postgres",
    "fhir-store"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fhirforge/core": "workspace:*",
    "@fhirforge/pg": "workspace:*",
    "@fhirforge/r4": "workspace:*"
  }
}
