      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@fhirforge/core": "workspace:*",
    "@fhirforge/pg": "workspace:*"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3"
  }
}
