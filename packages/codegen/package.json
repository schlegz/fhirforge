{
  "name": "@fhirforge/codegen",
  "version": "0.11.0",
  "description": "Generates strict TypeScript types for a FHIR version from its official definitions. Build-time only.",
  "license": "Apache-2.0",
  "author": "Scott Schlegel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlegz/fhirforge.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/schlegz/fhirforge#readme",
  "bugs": {
    "url": "https://github.com/schlegz/fhirforge/issues"
  },
  "keywords": [
    "fhir",
    "hl7",
    "typescript",
    "codegen",
    "types"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fhirforge-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fhirforge/definitions": "workspace:*",
    "@fhirforge/core": "workspace:*"
  }
}
