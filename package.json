{
  "name": "fhirforge-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/definitions packages/codegen packages/r4 packages/fhirforge",
    "test": "pnpm build && vitest run && pnpm test:types && pnpm test:examples",
    "test:types": "tsc -p packages/r4/tsconfig.test.json",
    "test:examples": "tsx packages/r4/scripts/check-examples.ts",
    "gen:r4": "tsc -b packages/codegen && node packages/codegen/dist/cli.js --package hl7.fhir.r4.core@4.0.1 --out packages/r4/src/generated",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.0.0",
    "expect-type": "^1.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
